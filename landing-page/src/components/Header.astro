---
import { Button } from '@/components/ui/button';
---

<header class="bg-background/80 supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50 flex h-16 w-full items-center border-b backdrop-blur bg-grid">
  <div class="container mx-auto flex h-16 items-center justify-between px-4 md:px-8">
    <div class="flex items-center gap-2">
      <img src="/icon.webp" alt="Akalin Icon" class="size-8 rounded-lg" />
      <span class="text-lg font-bold tracking-tight">Akalin</span>
    </div>
    
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a href="/#features" class="text-muted-foreground hover:text-foreground transition-colors">Features</a>
      <a href="/#testimonials" class="text-muted-foreground hover:text-foreground transition-colors">Testimonials</a>
      <a href="/#faq" class="text-muted-foreground hover:text-foreground transition-colors">FAQ</a>
      <a href="/docs" class="text-muted-foreground hover:text-foreground transition-colors">Docs</a>
      <a href="/blog" class="text-muted-foreground hover:text-foreground transition-colors">Blog</a>
    </nav>

    <div class="flex items-center gap-4">
      <a href="https://github.com/confusionhill/akalin" target="_blank" rel="noreferrer" class="text-muted-foreground hover:text-foreground transition-colors hidden sm:block">
        GitHub
      </a>
      <a href="/docs">
        <Button variant="default" className="font-semibold shadow-md">
          Get Started
        </Button>
      </a>
    </div>
  </div>
</header>
