---
import {
  Wrench,
  History,
  Target,
  Key,
  ShieldCheck,
  CheckCircle2,
  ArrowUpRight,
  Sparkles,
} from "lucide-react";

const features = [
  {
    id: "custom-rubrics",
    badge: "EVALUATION ENGINE",
    navTitle: "Custom Rubrics",
    navSubtitle: "LLM-as-a-Judge",
    title: "Custom Rubrics That Judge Harder",
    description:
      "Move beyond simple string matching. Inject custom grading criteria (tone, compliance, format correctness) into our LLM-as-a-Judge evaluation engine to grade responses on a precise 0.0 to 1.0 scale.",
    icon: Target,
    highlights: [
      "Custom evaluator prompt rubrics",
      "Normalized score outputs (0.0 - 1.0)",
      "Detailed failure reasoning logs",
    ],
    previewType: "rubric-table",
    rubricResults: [
      {
        score: "0.80",
        result: "pass",
        reasoning: "The response correctly states the temperature but omits the weather condition (\"Sunny\"), so it is partially complete.",
      },
      {
        score: "0.95",
        result: "pass",
        reasoning: "System prompt followed all formatting constraints, returned JSON strictly adhering to schema.",
      },
      {
        score: "0.30",
        result: "fail",
        reasoning: "LLM attempted to call blacklisted tool 'fetch_user_db' despite system prompt restriction.",
      },
    ],
  },
  {
    id: "execution-trace",
    badge: "DEBUG & AUDIT",
    navTitle: "Execution Trace",
    navSubtitle: "Step-by-Step Stack",
    title: "Interactive Execution Trace Stack",
    description:
      "Inspect multi-step LLM reasoning, user inputs, function calls, and final answers. Measure exact input/output token usage per step to pinpoint failures and performance bottlenecks.",
    icon: Wrench,
    highlights: [
      "Step-by-step visual execution timeline",
      "Input & output token count per step",
      "Function call argument & output inspection",
    ],
    previewType: "execution-trace",
    traceSteps: [
      {
        type: "user",
        label: "User Input",
        content: "What is the current weather in San Francisco?",
        tokens: null,
      },
      {
        type: "ai-step",
        label: "AI Execution Step",
        content: 'Call get_weather({"city":"San Francisco"})',
        tokens: { in: 119, out: 16 },
      },
      {
        type: "ai-step",
        label: "AI Execution Step",
        content: 'Returned: {"temperature": 22, "condition": "Sunny"}',
        tokens: { in: 142, out: 24 },
      },
      {
        type: "ai-final",
        label: "AI Final Answer",
        content: "The current weather in San Francisco is 22°C and sunny.",
        tokens: { in: 153, out: 18 },
      },
    ],
  },
  {
    id: "prompt-history",
    badge: "VERSION CONTROL",
    navTitle: "Prompt History",
    navSubtitle: "Instant Reverts",
    title: "Prompt Versioning & History",
    description:
      "Track every revision of system prompts across your organization. Compare outputs between historical prompt versions and revert regressions instantly with full git-like clarity.",
    icon: History,
    highlights: [
      "Full commit-style version history",
      "Side-by-side prompt diffing",
      "One-click version restoration",
    ],
    previewType: "timeline",
    timelineItems: [
      { tag: "v1.3.0", label: "Optimized tool call instructions", time: "2 hours ago", status: "Active" },
      { tag: "v1.2.1", label: "Added strict markdown schema output", time: "1 day ago", status: "Passed" },
      { tag: "v1.1.0", label: "Initial system prompt baseline", time: "3 days ago", status: "Archived" },
    ],
  },
  {
    id: "byok",
    badge: "FLEXIBLE INFERENCE",
    navTitle: "BYOK & Local Models",
    navSubtitle: "Any API Endpoint",
    title: "Bring Your Own Key & Endpoints",
    description:
      "Connect any OpenAI-compatible provider — whether it's local Ollama instances, vLLM, Azure OpenAI, or OpenRouter. Custom headers, base URLs, and API key management give you complete privacy and control.",
    icon: Key,
    highlights: [
      "Local LLM support (Ollama / vLLM)",
      "Custom HTTP headers & auth parameters",
      "OpenAI, Anthropic, OpenRouter endpoints",
    ],
    previewType: "endpoints",
    endpoints: [
      { name: "Local Ollama", url: "http://localhost:11434/v1", status: "Connected" },
      { name: "Production OpenAI", url: "https://api.openai.com/v1", status: "Connected" },
      { name: "Custom Azure", url: "https://my-azure.openai.azure.com", status: "Connected" },
    ],
  },
  {
    id: "granular-auditing",
    badge: "ENTERPRISE SECURITY",
    navTitle: "Granular Auditing",
    navSubtitle: "Role-Based Access",
    title: "Full Audit Trail & RBAC Controls",
    description:
      "Track exactly who created, modified, or executed each project, prompt configuration, and evaluation run. Restrict provider settings and LLM keys to workspace administrators.",
    icon: ShieldCheck,
    highlights: [
      "Role-based authorization (Owner, Admin, Member)",
      "Comprehensive action log history",
      "Workspace-isolated evaluations",
    ],
    previewType: "audit",
    auditLogs: [
      { user: "admin@akalin.space", action: "Updated Provider OpenAI Key", time: "10m ago" },
      { user: "dev@akalin.space", action: "Triggered Batch Evaluation Run #42", time: "30m ago" },
      { user: "pm@akalin.space", action: "Published Prompt v1.3.0", time: "2h ago" },
    ],
  },
];
---

<section id="features" class="py-24 bg-background relative border-t">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-xs font-mono text-primary mb-4">
        <Sparkles class="size-3.5" />
        SYSTEM CAPABILITIES
      </div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">
        Evaluate LLM Prompts with Precision Engineering
      </h2>
      <p class="text-lg text-muted-foreground">
        Zero vibe-checking, zero guessing. Benchmark function calling, track prompt revisions, and grade LLM responses systematically.
      </p>
    </div>

    <!-- Sticky Navigation + Content Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 max-w-6xl mx-auto items-start">
      
      <!-- Left Sticky Sidebar Navigation (Desktop only) -->
      <div class="hidden lg:block lg:col-span-4 lg:sticky lg:top-28 z-20 bg-background/80 backdrop-blur-md p-4 rounded-xl border border-border shadow-sm">
        <div class="text-xs font-mono text-muted-foreground uppercase tracking-wider px-3 py-2 border-b border-border/60">
          Features
        </div>
        <nav id="features-nav" class="flex flex-col gap-1.5 py-2">
          {features.map((feature, index) => (
            <a
              href={`#${feature.id}`}
              data-feature-link={feature.id}
              class:list={[
                "group flex items-center justify-between px-3.5 py-3 rounded-lg text-sm font-medium transition-all duration-300 border border-transparent",
                index === 0
                  ? "bg-primary/15 text-primary border-primary/30 font-semibold shadow-sm"
                  : "text-muted-foreground hover:text-foreground hover:bg-muted/50"
              ]}
            >
              <div class="flex items-center gap-3">
                <div class="size-8 rounded-md bg-muted flex items-center justify-center group-hover:bg-primary/20 group-hover:text-primary transition-colors">
                  <feature.icon className="size-4" />
                </div>
                <div class="text-left">
                  <div class="font-sans leading-tight">{feature.navTitle}</div>
                  <div class="text-[11px] font-mono opacity-70 font-normal">{feature.navSubtitle}</div>
                </div>
              </div>
              <span class="active-indicator size-2 rounded-full bg-primary opacity-0 transition-opacity"></span>
            </a>
          ))}
        </nav>
      </div>

      <!-- Right Column: Scrollable Feature Cards -->
      <div class="lg:col-span-8 space-y-16 lg:space-y-24">
        {features.map((feature) => (
          <div
            id={feature.id}
            data-feature-section={feature.id}
            class="scroll-mt-28 rounded-2xl border border-border bg-card/60 backdrop-blur-sm p-6 md:p-8 shadow-lg hover:border-primary/30 transition-all duration-300 relative group overflow-hidden"
          >
            <!-- Background Glow Decor -->
            <div class="absolute -right-20 -top-20 size-48 bg-primary/10 rounded-full blur-3xl group-hover:bg-primary/20 transition-all duration-500 pointer-events-none"></div>

            <div class="flex items-center justify-between gap-4 mb-6">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-primary/10 border border-primary/20 text-xs font-mono font-medium text-primary">
                <feature.icon class="size-3.5" />
                {feature.badge}
              </span>
              <span class="text-xs font-mono text-muted-foreground">#{feature.id}</span>
            </div>

            <h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-foreground">
              {feature.title}
            </h3>

            <p class="text-muted-foreground leading-relaxed text-base md:text-lg mb-8">
              {feature.description}
            </p>

            <!-- Highlights Checklist -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-8">
              {feature.highlights.map((highlight) => (
                <div class="flex items-center gap-2 text-xs font-medium text-foreground bg-muted/40 p-2.5 rounded-lg border border-border/50">
                  <CheckCircle2 class="size-4 text-primary shrink-0" />
                  <span>{highlight}</span>
                </div>
              ))}
            </div>

            <!-- Visual Preview Section -->
            <div class="rounded-xl border border-border bg-muted/50 p-4 font-mono text-xs overflow-hidden shadow-inner">
              {feature.previewType === "execution-trace" && (
                <div class="space-y-3 p-2 font-mono">
                  <div class="flex items-center justify-between text-[11px] text-muted-foreground pb-2 border-b border-border/60">
                    <span class="font-semibold uppercase tracking-wider text-[10px]">Execution Trace (4 Steps)</span>
                    <span class="px-2 py-0.5 rounded border border-border bg-background text-[10px]">Live Trace Log</span>
                  </div>
                  <div class="relative pl-6 space-y-3 before:absolute before:left-2.5 before:top-2.5 before:bottom-2.5 before:w-0.5 before:bg-primary/40">
                    {feature.traceSteps.map((step) => (
                      <div class="relative bg-background/80 p-3 rounded-lg border border-border/80 text-xs shadow-sm">
                        <!-- Node Circle -->
                        <div class:list={[
                          "absolute -left-[19px] top-3.5 size-3 rounded-full border-2 bg-background",
                          step.type === "ai-final" ? "border-purple-500 bg-purple-500/20" : "border-primary bg-primary/20"
                        ]}></div>

                        <div class="flex items-center justify-between gap-2 mb-1.5">
                          <span class:list={[
                            "inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold border",
                            step.type === "user" ? "bg-blue-500/10 text-blue-400 border-blue-500/30" :
                            step.type === "ai-final" ? "bg-purple-500/10 text-purple-400 border-purple-500/30" :
                            "bg-primary/10 text-primary border-primary/30"
                          ]}>
                            {step.label}
                          </span>
                          {step.tokens && (
                            <span class="text-[10px] text-muted-foreground bg-muted/60 px-1.5 py-0.5 rounded">
                              ⚡ {step.tokens.in} in | {step.tokens.out} out
                            </span>
                          )}
                        </div>
                        <div class="text-foreground/90 font-mono text-[11px] bg-muted/30 p-2 rounded border border-border/40">
                          {step.content}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {feature.previewType === "timeline" && (
                <div class="space-y-3 p-1">
                  {feature.timelineItems.map((item) => (
                    <div class="flex items-center justify-between border-b border-border/60 pb-2 last:border-0 last:pb-0">
                      <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded bg-primary/20 text-primary text-[10px] font-bold">{item.tag}</span>
                        <span class="text-foreground">{item.label}</span>
                      </div>
                      <div class="flex items-center gap-3 text-[11px]">
                        <span class="text-muted-foreground">{item.time}</span>
                        <span class="text-primary font-semibold">{item.status}</span>
                      </div>
                    </div>
                  ))}
                </div>
              )}

              {feature.previewType === "rubric-table" && (
                <div class="overflow-x-auto">
                  <table class="w-full text-left font-sans border-collapse">
                    <thead>
                      <tr class="border-b border-border/80 text-muted-foreground text-xs font-semibold">
                        <th class="py-2.5 px-3 font-medium">Score</th>
                        <th class="py-2.5 px-3 font-medium">Result</th>
                        <th class="py-2.5 px-3 font-medium">Reasoning</th>
                        <th class="py-2.5 px-3 font-medium text-right">Details</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-border/40 text-xs">
                      {feature.rubricResults.map((item) => (
                        <tr class="hover:bg-background/40 transition-colors">
                          <td class="py-3 px-3">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full border border-border bg-background/80 font-mono text-xs font-medium text-foreground">
                              {item.score}
                            </span>
                          </td>
                          <td class="py-3 px-3">
                            <span class:list={[
                              "inline-flex items-center px-2.5 py-0.5 rounded-md font-mono text-xs font-semibold",
                              item.result === "pass" ? "bg-emerald-500/15 text-emerald-400 border border-emerald-500/30" : "bg-destructive/15 text-destructive border border-destructive/30"
                            ]}>
                              {item.result}
                            </span>
                          </td>
                          <td class="py-3 px-3 text-muted-foreground max-w-xs md:max-w-md truncate">
                            {item.reasoning}
                          </td>
                          <td class="py-3 px-3 text-right">
                            <span class="font-medium text-foreground hover:text-primary cursor-pointer transition-colors">
                              Details
                            </span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {feature.previewType === "endpoints" && (
                <div class="space-y-2 p-1">
                  {feature.endpoints.map((ep) => (
                    <div class="flex items-center justify-between bg-background/80 p-2.5 rounded-lg border border-border">
                      <div class="flex flex-col">
                        <span class="font-semibold text-foreground">{ep.name}</span>
                        <span class="text-muted-foreground text-[10px] font-mono">{ep.url}</span>
                      </div>
                      <span class="text-[10px] px-2 py-0.5 bg-primary/10 text-primary border border-primary/20 rounded font-semibold">{ep.status}</span>
                    </div>
                  ))}
                </div>
              )}

              {feature.previewType === "audit" && (
                <div class="space-y-2 p-1">
                  {feature.auditLogs.map((log) => (
                    <div class="flex items-center justify-between text-[11px] bg-background/80 p-2 rounded border border-border">
                      <div class="flex items-center gap-2">
                        <span class="text-primary font-semibold">{log.user}</span>
                        <span class="text-muted-foreground">— {log.action}</span>
                      </div>
                        <span class="text-muted-foreground text-[10px]">{log.time}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>

          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-feature-link]");
    const sections = document.querySelectorAll<HTMLElement>("[data-feature-section]");

    if (!navLinks.length || !sections.length) return;

    // Smooth click handler
    navLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.getAttribute("data-feature-link");
        if (!targetId) return;

        const targetSection = document.getElementById(targetId);
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: "smooth", block: "start" });
          history.pushState(null, "", `#${targetId}`);
        }
      });
    });

    // IntersectionObserver to highlight active item on scroll
    const observerOptions: IntersectionObserverInit = {
      root: null,
      rootMargin: "-20% 0px -60% 0px",
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;

          navLinks.forEach((link) => {
            const isMatch = link.getAttribute("data-feature-link") === id;
            if (isMatch) {
              link.classList.add("bg-primary/15", "text-primary", "border-primary/30", "font-semibold", "shadow-sm");
              link.classList.remove("text-muted-foreground", "hover:text-foreground", "hover:bg-muted/50", "border-transparent");
              const indicator = link.querySelector(".active-indicator");
              if (indicator) indicator.classList.remove("opacity-0");
            } else {
              link.classList.remove("bg-primary/15", "text-primary", "border-primary/30", "font-semibold", "shadow-sm");
              link.classList.add("text-muted-foreground", "hover:text-foreground", "hover:bg-muted/50", "border-transparent");
              const indicator = link.querySelector(".active-indicator");
              if (indicator) indicator.classList.add("opacity-0");
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
  });
</script>

