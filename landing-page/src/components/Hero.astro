---
import { Button } from "@/components/ui/button";
import { ArrowRight } from "lucide-react";
---

<section
  class="relative pt-24 pb-16 md:pt-32 md:pb-24 lg:pt-40 lg:pb-32 overflow-hidden"
>
  <div class="container mx-auto px-4 md:px-8 text-center max-w-5xl">
    <h1
      class="text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-foreground leading-[1.1] mb-6 animate-in slide-in-from-bottom-6 fade-in duration-700"
    >
      Evaluate LLM Prompts <br class="hidden md:inline" />
      <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent"
        >With Precision</span
      >
    </h1>

    <p
      class="text-xl md:text-2xl text-muted-foreground mb-10 max-w-3xl mx-auto animate-in slide-in-from-bottom-8 fade-in duration-700 delay-150"
    >
      Akalin empowers developers to systematically <strong
        >evaluate LLM prompts with precision</strong
      >. Design, test, track, and grade system prompts against custom rubrics
      and programmatic checks with data-driven confidence.
    </p>

    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-in slide-in-from-bottom-10 fade-in duration-700 delay-300"
    >
      <a
        href="https://github.com/confusionhill/akalin"
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center h-14 px-8 text-lg font-bold tracking-tight rounded-full w-full sm:w-auto bg-primary text-primary-foreground hover:bg-primary/90 shadow-lg hover:shadow-primary/25 hover:-translate-y-0.5 transition-all duration-300 gap-2.5"
      >
        <svg
          class="size-5 shrink-0 fill-current"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
          ></path>
        </svg>
        <span>Steal Our Code</span>
        <span class="text-xl">🐙</span>
      </a>
      <a
        href="/docs"
        class="inline-flex items-center justify-center h-14 px-8 text-lg font-medium rounded-full w-full sm:w-auto border border-input bg-background hover:bg-accent hover:text-accent-foreground"
      >
        Read Documentation
      </a>
    </div>
  </div>

  {/* Decorative elements */}
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/5 rounded-full blur-[100px] -z-10"
  >
  </div>
</section>
