---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog | Akalin" description="Read the latest news and updates about Akalin.">
	<Header />
	<main class="container mx-auto px-4 md:px-8 py-16 max-w-4xl min-h-[calc(100vh-64px)]">
		<h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-8">Blog</h1>
		<ul class="space-y-8">
			{
				posts.map((post) => (
					<li class="border rounded-xl p-6 bg-card hover:border-primary/50 transition-colors">
						<a href={`/blog/${post.id}/`} class="block group">
							<h4 class="text-2xl font-bold group-hover:text-primary transition-colors mb-2">{post.data.title}</h4>
							<p class="text-muted-foreground mb-4">{post.data.description}</p>
							<p class="text-sm text-muted-foreground/80">
								{post.data.pubDate.toLocaleDateString('en-us', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Layout>
