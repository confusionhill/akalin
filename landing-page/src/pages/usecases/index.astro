---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const usecases = (await getCollection('usecases'))
	.filter((item) => !item.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Use Cases | Akalin" description="Explore how product teams, vibe coders, and engineering teams evaluate LLM prompts with Akalin.">
	<Header />
	<main class="container mx-auto px-4 md:px-8 py-16 max-w-4xl min-h-[calc(100vh-64px)]">
		<div class="mb-12">
			<h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">Use Cases</h1>
			<p class="text-lg text-muted-foreground">
				Discover how different teams use Akalin to benchmark prompts, automate rubrics, and ship reliable AI applications.
			</p>
		</div>
		
		<ul class="space-y-8">
			{
				usecases.map((item) => (
					<li class="border rounded-xl p-6 bg-card hover:border-primary/50 transition-all duration-300 shadow-sm hover:shadow-md">
						<a href={`/usecases/${item.id}/`} class="flex flex-col md:flex-row gap-6 group items-center">
							{item.data.heroImage && (
								<div class="w-full md:w-56 h-36 shrink-0 overflow-hidden rounded-lg border bg-muted">
									<img src={item.data.heroImage} alt={item.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
								</div>
							)}
							<div class="flex-1">
								{item.data.badge && (
									<span class="inline-block px-2.5 py-0.5 rounded-full bg-primary/10 border border-primary/20 text-[11px] font-mono text-primary font-semibold mb-2">
										{item.data.badge}
									</span>
								)}
								<h2 class="text-2xl font-bold group-hover:text-primary transition-colors mb-2 leading-tight">{item.data.title}</h2>
								<p class="text-muted-foreground mb-4 line-clamp-2 text-sm leading-relaxed">{item.data.description}</p>
								<p class="text-xs font-mono text-muted-foreground/80">
									{item.data.pubDate.toLocaleDateString('en-us', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Layout>
