---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import { getCollection } from "astro:content";

const latestUsecases = (await getCollection("usecases"))
	.filter((item) => !item.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<Layout
	title="Akalin | Evaluate LLM Prompts with Precision"
	description="Design, test, track, and grade LLM system prompts."
>
	<Header />
	<main>
		<Hero />

		{/* Social Proof Section */}
		<section class="py-12 border-y bg-muted/30">
			<div class="container mx-auto px-4 md:px-8">
				<p
					class="text-center text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-8"
				>
					Trusted by AI Native Teams Working in
				</p>
				<div
					class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-50 grayscale hover:grayscale-0 transition-all duration-500"
				>
					{/* Mock Logos for demonstration */}
					<h3 class="text-xl font-bold">Gojek</h3>
					<h3 class="text-xl font-bold">Gopay</h3>
					<h3 class="text-xl font-bold">Bytedance</h3>
					<h3 class="text-xl font-bold">Garena</h3>
				</div>
			</div>
		</section>

		{/* Media Section */}
		<section class="py-24 overflow-hidden">
			<div class="container mx-auto px-4 md:px-8">
				<div
					class="relative mx-auto max-w-5xl rounded-xl border bg-background/50 p-2 shadow-2xl backdrop-blur-sm lg:rounded-2xl lg:p-4 -mt-12 transition-all duration-700 hover:scale-[1.02]"
				>
					<div
						class="rounded-lg overflow-hidden border bg-muted shadow-inner relative group"
					>
						<img
							src="/dashboard-preview.png"
							alt="Akalin Evaluation Run Dashboard"
							class="w-full h-auto object-cover rounded-lg shadow-md"
						/>
					</div>
				</div>
			</div>
		</section>

		<Features />

		{/* Use Cases Section */}
		<section id="usecases" class="py-24 bg-muted/30 border-t">
			<div class="container mx-auto px-4 md:px-8">
				<div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 max-w-6xl mx-auto">
					<div>
						<span class="inline-block px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-xs font-mono text-primary font-semibold mb-3">
							REAL-WORLD APPLICATIONS
						</span>
						<h2 class="text-3xl md:text-5xl font-bold tracking-tight">
							Built for Every AI Workflow
						</h2>
					</div>
					<a
						href="/usecases"
						class="inline-flex items-center text-sm font-semibold text-primary hover:underline gap-1"
					>
						View all use cases &rarr;
					</a>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
					{latestUsecases.map((item) => (
						<a
							href={`/usecases/${item.id}/`}
							class="group flex flex-col justify-between rounded-xl border bg-card p-6 shadow-sm hover:border-primary/50 transition-all duration-300 hover:-translate-y-1"
						>
							<div>
								{item.data.badge && (
									<span class="inline-block px-2.5 py-0.5 rounded-full bg-primary/10 border border-primary/20 text-[10px] font-mono text-primary font-semibold mb-3">
										{item.data.badge}
									</span>
								)}
								<h3 class="text-xl font-bold group-hover:text-primary transition-colors mb-3 leading-snug">
									{item.data.title}
								</h3>
								<p class="text-sm text-muted-foreground line-clamp-3 leading-relaxed mb-6">
									{item.data.description}
								</p>
							</div>
							<div class="flex items-center justify-between text-xs font-mono text-muted-foreground pt-4 border-t border-border/60">
								<span>
									{item.data.pubDate.toLocaleDateString("en-us", {
										month: "short",
										day: "numeric",
										year: "numeric",
									})}
								</span>
								<span class="text-primary font-semibold group-hover:translate-x-0.5 transition-transform">Read &rarr;</span>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		{/* Testimonials */}
		<section id="testimonials" class="py-24 bg-muted/20">
			<div class="container mx-auto px-4 md:px-8">
				<div class="text-center mb-16 max-w-3xl mx-auto">
					<h2
						class="text-3xl md:text-5xl font-bold tracking-tight mb-4"
					>
						Loved by Vibe Coder!
					</h2>
				</div>
				<div
					class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto"
				>
					<div
						class="bg-background rounded-xl p-6 border shadow-sm flex flex-col justify-between hover:border-primary/40 transition-colors"
					>
						<p class="text-muted-foreground mb-4">
							"Akalin literally saved our repo from a massive L.
							We completely stopped testing on vibes. Now we
							benchmark system prompts and mock tool calls like
							actual pros. No cap 🧢."
						</p>
						<div class="flex items-center gap-3 pt-2 border-t">
							<div
								class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-lg"
							>
								⚡
							</div>
							<div>
								<div class="font-bold text-sm">24/7 Vibers</div>
								<div class="text-xs text-muted-foreground">
									Prompt Engineers @ Midnight
								</div>
							</div>
						</div>
					</div>
					<div
						class="bg-background rounded-xl p-6 border shadow-sm flex flex-col justify-between hover:border-primary/40 transition-colors"
					>
						<p class="text-muted-foreground mb-4">
							"The Mock Tool Calling & BYOK features are main
							character energy 💅. Being able to blacklist tools
							per run without draining API credits? We cooked fr
							fr."
						</p>
						<div class="flex items-center gap-3 pt-2 border-t">
							<div
								class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-lg"
							>
								🔥
							</div>
							<div>
								<div class="font-bold text-sm">
									Some Random Guy
								</div>
								<div class="text-xs text-muted-foreground">
									AI Native Engineer
								</div>
							</div>
						</div>
					</div>
					<div
						class="bg-background rounded-xl p-6 border shadow-sm flex flex-col justify-between hover:border-primary/40 transition-colors"
					>
						<p class="text-muted-foreground mb-4">
							"Running pipeline evaluations manually used to give
							me instant anxiety. Now we benchmark test cases with
							custom rubrics and audit tool calls with zero
							stress. Ate and left no crumbs 🤌."
						</p>

						<div class="flex items-center gap-3 pt-2 border-t">
							<div
								class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-lg"
							>
								💀
							</div>
							<div>
								<div class="font-bold text-sm">
									Sleep-Deprived Coders
								</div>
								<div class="text-xs text-muted-foreground">
									Production Survivors
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		{/* FAQ */}
		<section id="faq" class="py-24">
			<div class="container mx-auto px-4 md:px-8 max-w-3xl">
				<div class="text-center mb-16">
					<h2
						class="text-3xl md:text-5xl font-bold tracking-tight mb-4"
					>
						Frequently Asked Questions
					</h2>
				</div>
				<div class="space-y-4">
					<div class="border rounded-lg p-6 bg-card">
						<h3 class="font-bold text-lg mb-2">
							How does Tool Mocking work?
						</h3>
						<p class="text-muted-foreground">
							Define mock schemas and outputs (text or JSON) for
							functions like weather or database lookups. Akalin
							passes these natively to target models during
							evaluations and automatically feeds back mock
							responses when the LLM triggers function calls.
						</p>
					</div>
					<div class="border rounded-lg p-6 bg-card">
						<h3 class="font-bold text-lg mb-2">
							Can I use my own models?
						</h3>
						<p class="text-muted-foreground">
							Yes. You can configure any OpenAI-compatible API
							endpoint, meaning local Ollama instances, Azure
							OpenAI, or OpenRouter work out of the box.
						</p>
					</div>
					<div class="border rounded-lg p-6 bg-card">
						<h3 class="font-bold text-lg mb-2">
							How do custom rubrics work?
						</h3>
						<p class="text-muted-foreground">
							Instead of a simple pass/fail, you define a custom
							prompt that the evaluator LLM uses to grade
							responses on a scale of 0.0 to 1.0 based on your
							specific criteria.
						</p>
					</div>
					<div class="border rounded-lg p-6 bg-card">
						<h3 class="font-bold text-lg mb-2">
							Is my data private?
						</h3>
						<p class="text-muted-foreground">
							Since Akalin is open source, you can host the entire
							backend and database within your own infrastructure.
							Your prompt data never leaves your VPC unless sent
							to your chosen LLM provider.
						</p>
					</div>
				</div>
			</div>
		</section>

		{/* Final CTA */}
		<section
			class="py-32 relative overflow-hidden bg-primary text-primary-foreground"
		>
			<div class="absolute inset-0 bg-grid opacity-20"></div>
			<div
				class="container mx-auto px-4 md:px-8 text-center relative z-10"
			>
				<h2
					class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6"
				>
					Ready to Ship Better AI?
				</h2>
				<p class="text-xl mb-10 max-w-2xl mx-auto opacity-90">
					Stop guessing if your LLM prompts are improving. Start evaluating your system prompts with precision today.
				</p>
				<a
					href="https://github.com/confusionhill/akalin"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center bg-background text-foreground h-14 px-8 text-lg rounded-full shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300 font-semibold"
				>
					Deploy Open Source Version
				</a>
			</div>
		</section>
	</main>

	<footer class="py-12 border-t bg-background">
		<div
			class="container mx-auto px-4 md:px-8 flex flex-col md:flex-row items-center justify-between gap-6"
		>
			<div class="flex items-center gap-2">
				<img
					src="/icon.webp"
					alt="Akalin Icon"
					class="size-6 rounded"
				/>
				<span class="font-bold tracking-tight">Akalin</span>
			</div>
			<p class="text-sm text-muted-foreground">
				© 2026 Akalin. Open Source under GPL-3.0 License.
			</p>
			<div class="flex gap-4 text-sm font-medium">
				<a
					href="https://github.com/confusionhill/akalin"
					class="text-muted-foreground hover:text-foreground"
					>GitHub</a
				>
				<a
					href="/blog"
					class="text-muted-foreground hover:text-foreground">Blog</a
				>
			</div>
		</div>
	</footer>
</Layout>
