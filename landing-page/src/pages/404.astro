---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { Button } from "@/components/ui/button";
import { ArrowLeft } from "lucide-react";
---

<Layout
  title="404: Page Not Found | Akalin"
  description="The page you requested could not be found."
>
  <Header />

  <main class="flex min-h-[calc(100vh-10rem)] flex-col items-center justify-center relative overflow-hidden py-16 px-4">
    <div class="container relative z-10 max-w-lg mx-auto text-center flex flex-col items-center">
      <h1 class="text-7xl sm:text-9xl font-extrabold tracking-tight text-primary mb-2">
        404
      </h1>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mb-3">
        Page Not Found
      </h2>
      <p class="text-muted-foreground text-sm sm:text-base max-w-md mx-auto mb-8">
        Sorry, we couldn't find the page you're looking for. It might have been removed or the URL is incorrect.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-3">
        <a href="/">
          <Button variant="default" className="font-semibold shadow-md px-6 h-11 flex items-center gap-2">
            <ArrowLeft class="size-4" />
            Back to Home
          </Button>
        </a>
        <a href="/docs">
          <Button variant="outline" className="font-semibold px-6 h-11">
            Documentation
          </Button>
        </a>
      </div>
    </div>
  </main>
</Layout>
